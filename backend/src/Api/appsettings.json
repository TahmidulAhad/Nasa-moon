{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<NEON_HOST>;Port=5432;Database=nasamoon;Username=<NEON_USER>;Password=<NEON_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Secret": "<SET_Jwt__Secret_ENV_VAR>",
    "Issuer": "NasaMoon",
    "Audience": "NasaMoonApi",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  }
}
